{
  "info": {
    "name": "APIAQ Monitor local",
    "description": "Evidencias locales del monitor de aire. Arranque: python -m flask --app backend/app/main run. Clave OpenAQ solo en .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/salud"
      }
    },
    {
      "name": "02 Ubicaciones Medellin",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ubicaciones?ciudad=Medellin"
      }
    },
    {
      "name": "03 Ubicaciones busqueda vacia",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ubicaciones?ciudad="
      }
    },
    {
      "name": "04 Ubicaciones sin cobertura",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ubicaciones?ciudad=CiudadInventada"
      }
    },
    {
      "name": "05 Consultar Medellin AQI y OMS",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ciudad\": \"Medellin\"\n}"
        },
        "url": "{{baseUrl}}/consultar"
      }
    },
    {
      "name": "06 Consultar Bogota",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ciudad\": \"Bogota\"\n}"
        },
        "url": "{{baseUrl}}/consultar"
      }
    },
    {
      "name": "07 Consultar ciudad vacia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ciudad\": \"\"\n}"
        },
        "url": "{{baseUrl}}/consultar"
      }
    },
    {
      "name": "08 Consultar sin cobertura",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ciudad\": \"CiudadInventada\"\n}"
        },
        "url": "{{baseUrl}}/consultar"
      }
    },
    {
      "name": "09 Historial consultas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/historial"
      }
    },
    {
      "name": "10 Historial mediciones filtros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/historial/mediciones?contaminante=pm25&desde=2020-01-01T00:00:00Z&hasta=2030-01-01T00:00:00Z"
      }
    },
    {
      "name": "11 Historial mediciones rango vacio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/historial/mediciones?desde=2030-01-01T00:00:00Z&hasta=2030-01-02T00:00:00Z"
      }
    },
    {
      "name": "12 Historial descargar CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/historial/descargar"
      }
    }
  ]
}
